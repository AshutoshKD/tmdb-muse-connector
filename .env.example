# ================================================================
# TMDB MUSE CONNECTOR — Environment Variables
# ================================================================
# Get free API key at: https://www.themoviedb.org/settings/api
# ================================================================

# ── TMDB API Credentials ─────────────────────────────────────────
# From: https://www.themoviedb.org/settings/api
#
# RECOMMENDED: API Read Access Token (Bearer auth — works for v3 & v4)
# This is the preferred auth method per TMDB docs
TMDB_READ_TOKEN=your_api_read_access_token_here

# FALLBACK: API Key v3 (query param auth)
TMDB_API_KEY=your_tmdb_api_key_here

TMDB_API_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500

# ── Your Connector Secret ────────────────────────────────────────
# Muse sends this on every request to authenticate
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONNECTOR_SECRET_KEY=your_connector_secret_here

# ── Server Config ────────────────────────────────────────────────
PORT=3002
NODE_ENV=development
